{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "ApiKey": "",
    "VisionModel": "gpt-4o",
    "TextModel": "gpt-4o",
    "MaxTokens": 4096
  },
  "DocumentProcessing": {
    "UseSemanticKernel": true,
    "EnableRefinement": true,
    "EnableOcrFallback": true,
    "MaxOcrTextLength": 3000,
    "MaxFileSizeBytes": 10485760,
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },
  "Security": {
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 10,
    "AllowedFileTypes": [".pdf", ".png", ".jpg", ".jpeg", ".tiff"]
  }
}
