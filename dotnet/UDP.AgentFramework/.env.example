# LLM Provider Configuration
# Options: OpenAI, AzureOpenAI, Anthropic
LLM_PROVIDER=OpenAI

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-4o

# Anthropic (Azure AI Foundry) Configuration
ANTHROPIC_ENDPOINT=https://your-project.services.ai.azure.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Security Configuration
SECURITY_ENABLE_RATE_LIMITING=true
SECURITY_MAX_REQUESTS_PER_MINUTE=10

# Document Processing Configuration
DOCUMENT_PROCESSING_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_PROCESSING_MAX_OCR_TEXT_LENGTH=3000
